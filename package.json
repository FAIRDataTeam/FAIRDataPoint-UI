    "format-check": "prettier --check --experimental-cli .",
    "test": "vitest"
  },
  "dependencies": {
    "n3": "^2.1.1",
    "prismjs": "^1.30.0",
    "vis-data": "^8.0.4",
    "vis-network": "^10.1.0",
