{
  "name": "fairdatapoint-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli .",
    "format-check": "prettier --check --experimental-cli .",
    "test": "vitest"
  },
  "dependencies": {
    "n3": "^2.13.12",
    "prismjs": "^1.30.0",
    "vis-data": "^8.0.6",
    "vis-network": "^10.1.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/n3": "^1.26.6",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.90.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.14"
